# =============================================================================
# MZT APPS — compose environment. Copy to `$DEPLOY_DIR/.env` and FILL IN values.
#   cp deploy/.env.example $DEPLOY_DIR/.env ; vim $DEPLOY_DIR/.env
# =============================================================================

# Public ingress port exposed on the host.
PUBLIC_PORT=3015

# Public origin of the site (no /api suffix). Used by Laravel for generated URLs.
# Replace <server-ip> with your Proxmox host IP (or the domain once available).
APP_URL=http://<server-ip>:3015

# Laravel app key. Generate with:  php artisan key:generate --show
# (On the local checkout:  cd laravel-mzt && php artisan key:generate --show)
# Reuse your existing local key if any DB values are encrypted.
APP_KEY=

# MariaDB credentials (any you choose; used to create the DB + user on first boot).
MYSQL_DATABASE=mazw9983_alvinade_maziltu
MYSQL_USER=maziltu
MYSQL_PASSWORD=change-me-strong
MYSQL_ROOT_PASSWORD=change-me-root

# Baked into the frontend at build time. Public API base the browser calls
# (same-origin through Caddy). Format: http://<server-ip>:3015/api
VITE_API_BASE_URL=http://<server-ip>:3015/api

# Servers-side fetches reach the host's published port from inside Docker.
# This default is correct for a single-host deploy; override only if needed.
SSR_API_BASE_URL=http://host.docker.internal:3015/api