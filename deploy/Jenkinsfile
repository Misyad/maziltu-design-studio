// MZT APPS — deployment pipeline
// ---------------------------------------------------------------------------
// Runs on the same Proxmox host that runs Docker (agent 'docker'). It keeps a
// persistent deploy dir /opt/mzt with the app source and recreates the stack
// with `docker compose`. Files owned by the operator are NOT touched:
//   .env, db/init/*.sql, storage/
// ---------------------------------------------------------------------------

// Credentials registered in Jenkins (Jenkins > Manage > Credentials):
//   github-jenkins-key -> "GitHub/SSH" or "Username with password" credential
//   dockerhub/mzt-docker -> (optional) registry login, only if you later push
//                          images off-host.

pipeline {
    // Runs on any agent that has the Docker client + compose. On a standalone
    // Jenkins the built-in node works as-is; if you add remote agents, either
    // label them 'docker' here or keep 'any'.
    agent any

    options {
        timestamps()                        // readable build log timestamps
        timeout(time: 30, unit: 'MINUTES')  // hard cap per build
        buildDiscarder(logRotator(daysToKeepStr: '30', numToKeepStr: '10'))
    }

    triggers {
        // Auto-build when a commit lands on main (the SCM is the frontend repo;
        // backend changes are pulled during Sync, so they don't need their own job).
        pollSCM('H/5 * * * *')
    }

    environment {
        DEPLOY_DIR     = "/opt/mzt"
        PUBLIC_PORT    = "3015"
        // IP of this Docker host, reachable from the Jenkins agent. The health
        // check runs inside the Jenkins container, which has no mapping for the
        // stack's published port, so it must hit the host over the network.
        HOST_IP        = "192.168.1.60"
        // Public HTTPS clones — no credentials needed.
        FRONTEND_REPO  = "https://github.com/Misyad/maziltu-design-studio.git"
        BACKEND_REPO   = "https://github.com/Misyad/laravel-mzt.git"
    }

    stages {
        stage('Validate host') {
            steps {
                sh '''
                    set -e
                    command -v docker >/dev/null || { echo "docker not found"; exit 1; }
                    command -v git   >/dev/null || { echo "git not found"; exit 1; }
                    docker compose version >/dev/null 2>&1 \
                        || docker-compose --version >/dev/null 2>&1 \
                        || { echo "docker compose not available"; exit 1; }
                    mkdir -p "$DEPLOY_DIR"
                '''
            }
        }

        stage('Sync source') {
            steps {
                // Clone/pull both public repos into the persistent deploy dir.
                // HTTPS is used so no GitHub credentials are required.
                sh '''
                    set -e
                    clone() {
                        repo="$1"; dir="$2"
                        if [ -d "$dir/.git" ]; then
                            (cd "$dir" && git pull --ff-only) || git -C "$dir" reset --hard '@{u}'
                        else
                            git clone --depth 1 "$repo" "$dir"
                        fi
                        git -C "$dir" describe --always >/dev/null
                    }

                    clone "$FRONTEND_REPO" "$DEPLOY_DIR/frontend"
                    clone "$BACKEND_REPO"  "$DEPLOY_DIR/backend"
                '''

                // Refresh the orchestration files the pipeline owns.
                sh '''
                    set -e
                    # Data dirs the operator owns (media + DB import on first boot).
                    mkdir -p "$DEPLOY_DIR/storage" "$DEPLOY_DIR/db/init"

                    cp "$DEPLOY_DIR/frontend/deploy/docker-compose.yml" "$DEPLOY_DIR/docker-compose.yml"
                    cp "$DEPLOY_DIR/frontend/deploy/Caddyfile"          "$DEPLOY_DIR/Caddyfile"
                    cp "$DEPLOY_DIR/frontend/deploy/db/init/.gitkeep"   "$DEPLOY_DIR/db/init/.gitkeep"

                    # Seed the DB dump from the backend repo on first boot only;
                    # never overwrite a dump the operator has dropped in here.
                    if [ -f "$DEPLOY_DIR/backend/deploy/db/mazw9983_alvinade_maziltu.sql" ] \
                        && [ ! -f "$DEPLOY_DIR/db/init/mazw9983_alvinade_maziltu.sql" ]; then
                        cp "$DEPLOY_DIR/backend/deploy/db/mazw9983_alvinade_maziltu.sql" \
                           "$DEPLOY_DIR/db/init/mazw9983_alvinade_maziltu.sql"
                    fi

                    # Seed .env once; never overwrite operator edits afterwards.
                    [ -f "$DEPLOY_DIR/.env" ] || cp "$DEPLOY_DIR/frontend/deploy/.env.example" "$DEPLOY_DIR/.env"
                '''
            }
        }

        stage('Build images') {
            steps {
                dir("$DEPLOY_DIR") {
                    sh 'docker compose build --pull'
                }
            }
        }

        stage('Deploy stack') {
            steps {
                dir("$DEPLOY_DIR") {
                    sh 'docker compose up -d'
                }
            }
        }

        stage('Migrate DB') {
            steps {
                // Apply additive schema changes after the stack is up and verify
                // them against information_schema (single source of truth), BEFORE
                // the health check gates the build. `migrate --force` is idempotent
                // (adds only the missing nullable columns). No grep on migration
                // names: columns are the ground truth.
                sh '''
                    set -e
                    cd "$DEPLOY_DIR"
                    echo "== run migration =="
                    timeout 180 docker compose exec -T backend \
                        php artisan migrate --force --no-interaction

                    echo "== verify audit columns exist (information_schema) =="
                    # Credentials are read from the host .env (not the container env)
                    # so we can run `mariadb` directly without a nested `sh -c`, which
                    # previously mangled the SQL quoting. MariaDB 11.4 ships the
                    # `mariadb` client (no `mysql` binary).
                    DB=$(sed -n 's/^MYSQL_DATABASE=//p' "$DEPLOY_DIR/.env" | tr -d '\r')
                    PW=$(sed -n 's/^MYSQL_ROOT_PASSWORD=//p' "$DEPLOY_DIR/.env" | tr -d '\r')
                    timeout 120 docker compose exec -T db mariadb -uroot -p"$PW" -N -e \
                        "SELECT GROUP_CONCAT(COLUMN_NAME) FROM information_schema.COLUMNS \
                         WHERE TABLE_SCHEMA='$DB' AND TABLE_NAME='users' \
                           AND COLUMN_NAME IN ('last_login','password_changed_at','login_count');"

echo "== verify Phase 2A EMS schema (orders table + events columns) =="
                    phase2a=$(timeout 120 docker compose exec -T db mariadb -uroot -p"$PW" -N -e "SELECT CONCAT((SELECT COUNT(*) FROM information_schema.TABLES WHERE TABLE_SCHEMA='$DB' AND TABLE_NAME='orders'),'|',(SELECT GROUP_CONCAT(COLUMN_NAME ORDER BY COLUMN_NAME) FROM information_schema.COLUMNS WHERE TABLE_SCHEMA='$DB' AND TABLE_NAME='events' AND COLUMN_NAME IN ('kuota','venue','visibility','registrasi_dibuka','registrasi_ditutup','harga_amount')))" | tr -d '\r')
                    echo "phase2a => ${phase2a}"
                    if [ "$phase2a" != "1|harga_amount,kuota,registrasi_dibuka,registrasi_ditutup,venue,visibility" ]; then echo "Phase 2A schema missing (orders table or events columns)"; exit 1; fi
                '''
            }
        }

        stage('Health check') {
            steps {
                // Give containers a moment, then probe /api/public/stats. This
                // endpoint reads the database (Event/event_status/DataUser counts)
                // and returns 200 + success:true only when the DB is reachable, so
                // the gate exercises a real DB round-trip.
                script {
                    timeout(time: 2, unit: 'MINUTES') {
                        sh '''
                            set +e
                            sleep 10
                            docker compose -f "$DEPLOY_DIR/docker-compose.yml" ps
                            code=$(curl -sS -o /tmp/mzt_health.json -w "%{http_code}" \
                                "http://${HOST_IP}:${PUBLIC_PORT}/api/public/stats")
                            echo "  /api/public/stats -> code=$code"
                            echo "  body: $(cat /tmp/mzt_health.json)"
                            [ "$code" = "200" ] || exit 1
                            grep -q '"success":true' /tmp/mzt_health.json || exit 1
                        '''
                    }
                }
            }
        }

        stage('Prune') {
            steps {
                sh '''
                    # Drop unused images from previous builds (keeps disk tidy).
                    docker image prune -f --filter "until=168h" >/dev/null 2>&1 || true
                    docker builder prune -f --filter "until=72h" >/dev/null 2>&1 || true
                    cd "$DEPLOY_DIR" && docker compose ps --status running | awk '\''NR>1 && $1 ~ /mzt|backend|frontend|caddy|db/ {print}'\''
                '''
            }
        }
    }

    post {
        always {
            echo "Pipeline finished: ${currentBuild.currentResult}"
        }
        failure {
            echo "Deploy failed. Check /opt/mzt (.env, db/init, storage) and the console output."
            // Optionally notify: slackSend / emailext ... (uncomment as needed)
        }
    }
}